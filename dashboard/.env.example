# Copy to .env.local (dev) / .dev.vars (wrangler dev) — both are git-ignored. For the deployed app:
#   npx wrangler secret put CALENDAR_SOURCES
#
# One JSON array on a single line. Each source:
#   name    label (shown nowhere yet, handy for logs)
#   url     private ICS link. Google: Calendar settings > "Secret address in iCal format".
#           iCloud: Calendar app > share icon > Public Calendar > copy link (webcal://… is fine).
#   color   optional #rrggbb colour for this calendar's events
CALENDAR_SOURCES=[{"name":"Family (Google)","url":"https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics"},{"name":"Shared (iCloud)","url":"webcal://p01-caldav.icloud.com/published/2/REPLACE","color":"#2D5BFF"}]

# Google sign-in (sees shared calendars too). Create a Desktop-app OAuth client in Google Cloud, put its
# id/secret here, then run `npm run google-login` — it writes GOOGLE_REFRESH_TOKEN for you.
# Optional GOOGLE_CALENDARS picks calendars + colours; default is every calendar ticked in Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDARS=[{"id":"you@gmail.com","color":"#2D5BFF"},{"id":"primary"}]

# iCloud over CalDAV (also sees calendars shared with you). Make an app-specific password at
# appleid.apple.com > Sign-In and Security > App-Specific Passwords. Use the Apple ID the calendar was shared to.
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
# Optional: pick calendars by name, set colour (default: all event calendars)
# ICLOUD_CALENDARS=[{"name":"Shared Family","color":"#2D5BFF"}]

# Google Nest (thermostat + cameras). Needs a Device Access project (console.nest.google.com/device-access, $5 once)
# and a *Web application* OAuth client with redirect URI https://www.google.com. Then `npm run nest-login`.
NEST_PROJECT_ID=
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_REFRESH_TOKEN=


# Tuya cloud (Globe smart plugs paired in the Smart Life app). iot.tuya.com > Cloud > Create project (Smart Home),
# link your Smart Life account under the project's Devices tab, then copy Access ID / Secret from Overview.
# TUYA_REGION: us (Western America) | us-east | eu | eu-west | in | sg | cn — match your app's data center.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=us

# Toronto curbside collection defaults to Thursday2 (server/waste.js). Override with e.g. TORONTO_CALENDAR=Tuesday1
# (day + week 1 or 2).
# TORONTO_CALENDAR=

# Weather: Scarborough, ON by default (Open-Meteo, no key). Uncomment to use another place.
# WEATHER_LAT=43.7764
# WEATHER_LON=-79.2318
# WEATHER_NAME=Scarborough, ON

# "Time to clinic" card on Today: live drive time from Mapbox (driving-traffic). Create a token at account.mapbox.com > Tokens.
# Addresses are looked up once on the server; they never reach the frame. Use HOME_LAT/HOME_LON or CLINIC_LAT/CLINIC_LON instead if you prefer.
# MAPBOX_TOKEN=
# HOME_ADDRESS=
# CLINIC_ADDRESS=
# CLINIC_NAME=Clinic
# Optional second clinic, shown beside the first on the same card (use short names so both fit):
# CLINIC2_ADDRESS=
# CLINIC2_NAME=

# Shopping list: a Todoist project. Token from Todoist > Settings > Integrations > Developer.
# Add items as "Eggs ×2" with an @label for the category (@produce, @dairy-eggs, @meat-fish, @bakery, @pantry,
# @frozen, @snacks, @household). The store is the section the task sits in: sections named Walmart, Costco
# and Chinese in the project (no section = no store).
TODOIST_TOKEN=
# TODOIST_PROJECT=Groceries

# GO Transit live departures (Transit tab). Register at https://api.openmetrolinx.com/OpenDataAPI/ for an access key.
# Without it the tab still shows the planned timetable. Stations and lines are chosen in transit.json
# (then `npm run transit-build -- ~/Downloads/GO-GTFS.zip`).
METROLINX_KEY=

# "Time to station" card on the Transit tab: home -> parking (live traffic) -> walk to the station. Uses MAPBOX_TOKEN and
# HOME_* above. The station's location comes from the timetable. Use PARKING_LAT/PARKING_LON instead if you prefer.
# PARKING_ADDRESS=
# PARKING_NAME=Parking lot
# Optional per-station parking for the alternate route (without it: drive straight to the station, no walk):
# PARKING_XX_ADDRESS=   (XX = the station code, e.g. PARKING_UN_ADDRESS)
# PARKING_XX_NAME=Station lot
